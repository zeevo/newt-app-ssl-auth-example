{
  "name": "@newt-app-ssl-auth-example/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "generate": "dotenv -e ../../.env -v AUTH_CLI=1 -- auth generate --config src/cli.ts",
    "migrate": "dotenv -e ../../.env -v AUTH_CLI=1 -- auth migrate -y --config src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@newt-app-ssl-auth-example/db": "workspace:*",
    "auth": "^1.5.5",
    "better-auth": "^1.2.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@newt-app-ssl-auth-example/typescript-config": "workspace:*",
    "dotenv-cli": "^11.0.0",
    "typescript": "6.0.2"
  }
}
