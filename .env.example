# Postgres connection string. pnpm db:up starts a local Postgres matching this.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/newt
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32

# docker compose only: password for the bundled Postgres service
# POSTGRES_PASSWORD=generate-with-openssl-rand-base64-32

# Which UserService signs users in: "certificate" (default) trusts the client
# certificate DN that nginx forwards; "devin" signs everyone in as Devin E. Loper
# (development only, refused when NODE_ENV=production; see pnpm dev:devin)
# USER_SERVICE=certificate
# Request header nginx puts the client certificate DN in
# DN_HEADER=x-dn

# docker compose only: admin created on startup if no user has this DN yet
# (set all three or none). Existing users are never changed, so this is safe
# to leave set.
# INITIAL_ADMIN_DN=CN=Jane Admin,OU=IT,O=Example,C=US
# INITIAL_ADMIN_NAME=Jane Admin
# INITIAL_ADMIN_EMAIL=jane.admin@example.com
